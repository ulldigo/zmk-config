/*
 * Sofle Choc Pro BT — Swiss CH / QWERTZ
 *
 * Layout based on the Keebart Sofle Choc Pro BT matrix.
 *
 * Host keyboard layout:
 *   - Windows: Swiss German
 *   - macOS:   Swiss German
 *
 * FN behavior:
 *   - Hold FN: ADJUST/System layer
 *   - Double-tap FN: toggle Windows/macOS modifier mode
 *   - Single tap FN: no action
 *
 * Windows thumb modifiers:
 *   Control | Win | Alt | Lower | Enter   ||   Space | Raise | Backspace | AltGr | FN
 *
 * macOS thumb modifiers:
 *   Control | Option | Command | Lower | Enter   ||   Space | Raise | Backspace | Command | FN
 *
 * Lower + Raise also activates ADJUST.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/modifiers.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>

#define BASE       0
#define MAC        1
#define LOWER      2
#define RAISE      3
#define MAC_LOWER  4
#define MAC_RAISE  5
#define ADJUST     6

/ {
    behaviors {
        /* Swiss CH, Lower+§: plain ^, Shift ~, AltGr/Option ` . */
        ch_grave: ch_grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            /* Shift + physical caret (^), then Space: dead grave on CH. */
            bindings = <&kp LS(EQUAL) &kp SPACE>;
        };
        ch_tilde_win: ch_tilde_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            /* Windows-CH: AltGr + caret key, then Space. */
            bindings = <&kp RA(EQUAL) &kp SPACE>;
        };
        ch_tilde_mac: ch_tilde_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            /* macOS-CH: Option + N, then Space. */
            bindings = <&kp LA(N) &kp SPACE>;
        };
        ch_alt_win: ch_alt_win {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp EQUAL>, <&ch_grave>;
            mods = <MOD_RALT>;
        };
        ch_alt_mac: ch_alt_mac {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp EQUAL>, <&ch_grave>;
            mods = <(MOD_LALT|MOD_RALT)>;
        };
        /* Shift first: Shift+Alt always selects the tilde. */
        ch_shift_win: ch_shift_win {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&ch_alt_win>, <&ch_tilde_win>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        ch_shift_mac: ch_shift_mac {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&ch_alt_mac>, <&ch_tilde_mac>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        /*
         * Nested behavior used by the FN tap-dance.
         * Hold -> ADJUST, tap -> nothing.
         */
        fn_hold: fn_hold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <180>;
            bindings = <&mo>, <&none>;
        };

        /*
         * FN:
         *   hold        -> ADJUST
         *   double tap  -> toggle MAC overlay
         *   single tap  -> no action
         */
        fn_os: fn_os {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&fn_hold ADJUST 0>, <&tog MAC>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };

        mac_lower_layer {
            if-layers = <MAC LOWER>;
            then-layer = <MAC_LOWER>;
        };

        mac_raise_layer {
            if-layers = <MAC RAISE>;
            then-layer = <MAC_RAISE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Swiss CH";
            /*
             * | §° | 1 | 2 | 3 | 4 | 5 |                    | 6 | 7 | 8 | 9 | 0 | '? |
             * |Esc | Q | W | E | R | T |                    | Z | U | I | O | P | Ü  |
             * |Tab | A | S | D | F | G |                    | H | J | K | L | Ö | Ä  |
             * |Shft|<> | Y | X | C | V | Mute | | Play/Pause | B | N | M | , | . | - |
             *             |Ctrl|Win|Alt|Lower|Enter| |Space|Raise|Bspc|AltGr|FN|
             */
            bindings = <
        &kp GRAVE   &kp N1   &kp N2   &kp N3   &kp N4   &kp N5   &kp N6   &kp N7   &kp N8   &kp N9   &kp N0   &kp MINUS
        &kp ESC   &kp Q   &kp W   &kp E   &kp R   &kp T   &kp Y   &kp U   &kp I   &kp O   &kp P   &kp LBKT
        &kp TAB   &kp A   &kp S   &kp D   &kp F   &kp G   &kp H   &kp J   &kp K   &kp L   &kp SEMI   &kp SQT
        &kp LSHFT   &kp NUBS   &kp Z   &kp X   &kp C   &kp V   &kp C_MUTE   &kp C_PP   &kp B   &kp N   &kp M   &kp COMMA   &kp DOT   &kp FSLH
        &kp LCTRL   &kp LGUI   &kp LALT   &mo LOWER   &kp RET   &kp SPACE   &mo RAISE   &kp BSPC   &kp RALT   &fn_os
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_PREV C_NEXT>;
        };

        mac_layer {
            display-name = "macOS";
            /*
             * macOS Swiss-German overlay:
             * - swap the two ISO positions (§/° and </>) to match macOS de-CH
             * - Win -> Option, Alt -> Command, AltGr -> right Command
             */
            bindings = <
        &kp NUBS   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans
        &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans
        &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans
        &trans   &kp GRAVE   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans
        &trans   &kp LALT   &kp LGUI   &trans   &trans   &trans   &trans   &trans   &kp RGUI   &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_PREV C_NEXT>;
        };

        lower_layer {
            display-name = "Lower";
            /*
             * F1-F11 on the number row, F12 on Esc.
             * Missing Swiss ISO physical keys are restored positionally:
             *   Lower+§  -> ^ / Shift+Lower+§ -> ~ / AltGr+Lower+§ -> `
             *   Lower+Ü  -> physical ¨/!/ ] key (RBKT usage)
             *   Lower+Ä  -> physical $/£/} key (NUHS usage)
             */
            bindings = <
        &ch_shift_win   &kp F1   &kp F2   &kp F3   &kp F4   &kp F5   &kp F6   &kp F7   &kp F8   &kp F9   &kp F10   &kp F11
        &kp F12   &kp C_BRI_DN   &kp C_BRI_UP   &kp LG(TAB)   &kp LGUI   &rgb_ug RGB_BRD   &rgb_ug RGB_BRI   &kp C_PREV   &kp C_PP   &kp C_NEXT   &kp C_MUTE   &kp RBKT
        &kp CAPSLOCK   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &kp C_VOL_DN   &kp C_VOL_UP   &kp NUHS
        &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans
        &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_PREV C_NEXT>;
        };

        raise_layer {
            display-name = "Raise";
            bindings = <
        &bt BT_CLR   &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4   &trans   &trans   &trans   &trans   &trans   &trans
        &kp INS   &kp PSCRN   &kp K_CMENU   &trans   &trans   &trans   &trans   &kp HOME   &kp UP   &kp END   &kp PG_UP   &kp DEL
        &trans   &kp LALT   &kp LCTRL   &kp LSHFT   &trans   &trans   &trans   &kp LEFT   &kp DOWN   &kp RIGHT   &kp PG_DN   &kp BSPC
        &trans   &trans   &kp LC(Y)   &kp LC(X)   &kp LC(C)   &kp LC(V)   &trans   &trans   &studio_unlock   &trans   &trans   &trans   &trans   &trans
        &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_PREV C_NEXT>;
        };

        mac_lower_layer_keymap {
            display-name = "macOS Lower";
            /*
             * macOS-specific overrides:
             * § -> macOS-specific ^/~ / ` behavior
             * E -> Mission Control / all windows
             * R -> show applications
             */
            bindings = <
        &ch_shift_mac   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans
        &trans   &trans   &trans   &kp C_AC_DESKTOP_SHOW_ALL_WINDOWS   &kp C_AC_DESKTOP_SHOW_ALL_APPLICATIONS   &trans   &trans   &trans   &trans   &trans   &trans   &trans
        &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans
        &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans
        &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_PREV C_NEXT>;
        };

        mac_raise_layer_keymap {
            display-name = "macOS Raise";
            /*
             * macOS editing shortcuts:
             * Y = Cmd+Z, X = Cmd+X, C = Cmd+C, V = Cmd+V
             */
            bindings = <
        &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans
        &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans
        &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans
        &trans   &trans   &kp LG(Y)   &kp LG(X)   &kp LG(C)   &kp LG(V)   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans
        &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_PREV C_NEXT>;
        };

        adjust_layer_keymap {
            display-name = "Fn / Adjust";
            bindings = <
        &bt BT_CLR   &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4   &none   &none   &none   &none   &none   &none
        &ext_power EP_TOG   &rgb_ug RGB_HUD   &rgb_ug RGB_HUI   &rgb_ug RGB_SAD   &rgb_ug RGB_SAI   &rgb_ug RGB_EFF   &none   &none   &none   &none   &none   &none
        &none   &rgb_ug RGB_BRD   &rgb_ug RGB_BRI   &none   &none   &none   &none   &none   &none   &none   &none   &none
        &none   &none   &none   &none   &none   &none   &rgb_ug RGB_TOG   &none   &none   &none   &none   &none   &none   &none
        &none   &none   &none   &none   &none   &none   &none   &none   &none   &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_PREV C_NEXT>;
        };
    };
};
